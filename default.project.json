{
  "name": "GalaxyMiningSimulator",
  "serveAddress": "127.0.0.1",
  "servePort": 34872,
  "tree": {
    "$className": "DataModel",
    "$ignoreUnknownInstances": true,
    "Workspace": {
      "$className": "Workspace",
      "$ignoreUnknownInstances": true,
      "TerraNova": {
        "$path": "src/world/terra-nova.project.json"
      },
      "SpawnLocation": {
        "$className": "SpawnLocation",
        "$ignoreUnknownInstances": true,
        "$properties": {
          "Anchored": true,
          "Position": [
            0,
            1.5,
            0
          ],
          "Size": [
            8,
            1,
            8
          ],
          "Neutral": true,
          "Duration": 0,
          "Color": [
            0.15,
            0.85,
            0.95
          ],
          "Material": "Metal"
        }
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$ignoreUnknownInstances": true,
      "$properties": {
        "ClockTime": 0.5,
        "Brightness": 3.0,
        "ExposureCompensation": 0.35,
        "Ambient": [
          0.34,
          0.38,
          0.62
        ],
        "OutdoorAmbient": [
          0.4,
          0.45,
          0.75
        ],
        "EnvironmentDiffuseScale": 0.6,
        "EnvironmentSpecularScale": 0.6,
        "ColorShift_Top": [
          0.5,
          0.6,
          1.0
        ]
      },
      "TerraNovaAtmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.12,
          "Haze": 0.9,
          "Offset": 0.08,
          "Glare": 0,
          "Color": [
            0.45,
            0.5,
            0.9
          ],
          "Decay": [
            0.25,
            0.15,
            0.5
          ]
        }
      },
      "TerraNovaBloom": {
        "$className": "BloomEffect",
        "$properties": {
          "Intensity": 1.1,
          "Size": 36,
          "Threshold": 1.1
        }
      },
      "TerraNovaSunRays": {
        "$className": "SunRaysEffect",
        "$properties": {
          "Intensity": 0.0,
          "Spread": 0.8
        }
      },
      "TerraNovaDepth": {
        "$className": "DepthOfFieldEffect",
        "$properties": {
          "FarIntensity": 0.12,
          "FocusDistance": 60,
          "InFocusRadius": 40,
          "NearIntensity": 0
        }
      },
      "TerraNovaSky": {
        "$className": "Sky",
        "$properties": {
          "StarCount": 5000,
          "SunAngularSize": 8,
          "MoonAngularSize": 0
        }
      },
      "TerraNovaColor": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Contrast": 0.12,
          "Saturation": 0.25,
          "TintColor": [
            0.95,
            0.95,
            1.0
          ]
        }
      }
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$ignoreUnknownInstances": true,
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$ignoreUnknownInstances": true,
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$ignoreUnknownInstances": true,
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$ignoreUnknownInstances": true,
        "Client": {
          "$path": "src/client"
        }
      }
    }
  }
}
