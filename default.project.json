{
  "name": "GalaxyMiningSimulator",
  "serveAddress": "127.0.0.1",
  "servePort": 34872,
  "tree": {
    "$className": "DataModel",
    "$ignoreUnknownInstances": true,
    "Workspace": {
      "$className": "Workspace",
      "$ignoreUnknownInstances": true,
      "TerraNova": { "$path": "src/world/terra-nova.project.json" },
      "SpawnLocation": {
        "$className": "SpawnLocation",
        "$ignoreUnknownInstances": true,
        "$properties": {
          "Anchored": true,
          "Position": [0, 1.5, 0],
          "Size": [8, 1, 8],
          "Neutral": true,
          "Duration": 0,
          "Color": [0.15, 0.85, 0.95],
          "Material": "Metal"
        }
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$ignoreUnknownInstances": true,
      "$properties": {
        "ClockTime": 14.2,
        "Brightness": 2.5,
        "Ambient": [0.35, 0.37, 0.49],
        "OutdoorAmbient": [0.54, 0.59, 0.71],
        "EnvironmentDiffuseScale": 0.45,
        "EnvironmentSpecularScale": 0.5
      },
      "TerraNovaAtmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.27,
          "Haze": 1.45,
          "Glare": 0,
          "Color": [0.66, 0.80, 1.0],
          "Decay": [0.58, 0.45, 0.77]
        }
      }
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$ignoreUnknownInstances": true,
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$ignoreUnknownInstances": true,
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$ignoreUnknownInstances": true,
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$ignoreUnknownInstances": true,
        "Client": {
          "$path": "src/client"
        }
      }
    }
  }
}

