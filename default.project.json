{
  "name": "GalaxyMiningSimulator",
  "serveAddress": "127.0.0.1",
  "servePort": 34872,
  "tree": {
    "$className": "DataModel",
    "$ignoreUnknownInstances": true,
    "Workspace": {
      "$className": "Workspace",
      "$ignoreUnknownInstances": true,
      "TerraNova": {
        "$path": "src/world/terra-nova.project.json"
      },
      "SpawnLocation": {
        "$className": "SpawnLocation",
        "$ignoreUnknownInstances": true,
        "$properties": {
          "Anchored": true,
          "Position": [
            0,
            1.5,
            0
          ],
          "Size": [
            8,
            1,
            8
          ],
          "Neutral": true,
          "Duration": 0,
          "Color": [
            0.15,
            0.85,
            0.95
          ],
          "Material": "Metal"
        }
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$ignoreUnknownInstances": true,
      "$properties": {
        "ClockTime": 14.5,
        "Brightness": 3.2,
        "ExposureCompensation": 0.3,
        "Ambient": [
          0.62,
          0.55,
          0.85
        ],
        "OutdoorAmbient": [
          0.7,
          0.62,
          0.95
        ],
        "EnvironmentDiffuseScale": 0.6,
        "EnvironmentSpecularScale": 0.4,
        "ColorShift_Top": [
          1.0,
          0.85,
          1.0
        ]
      },
      "TerraNovaAtmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.3,
          "Haze": 1.6,
          "Offset": 0.1,
          "Glare": 0.3,
          "Color": [
            0.8,
            0.65,
            1.0
          ],
          "Decay": [
            1.0,
            0.55,
            0.85
          ]
        }
      },
      "TerraNovaBloom": {
        "$className": "BloomEffect",
        "$properties": {
          "Intensity": 0.45,
          "Size": 30,
          "Threshold": 1.5
        }
      },
      "TerraNovaSunRays": {
        "$className": "SunRaysEffect",
        "$properties": {
          "Intensity": 0.15,
          "Spread": 0.9
        }
      },
      "TerraNovaDepth": {
        "$className": "DepthOfFieldEffect",
        "$properties": {
          "FarIntensity": 0.05,
          "FocusDistance": 60,
          "InFocusRadius": 40,
          "NearIntensity": 0
        }
      },
      "TerraNovaSky": {
        "$className": "Sky",
        "$properties": {
          "StarCount": 3000,
          "SunAngularSize": 16,
          "MoonAngularSize": 0
        }
      },
      "TerraNovaColor": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Contrast": 0.08,
          "Saturation": 0.3,
          "TintColor": [
            1.0,
            0.97,
            1.0
          ]
        }
      }
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$ignoreUnknownInstances": true,
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$ignoreUnknownInstances": true,
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$ignoreUnknownInstances": true,
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$ignoreUnknownInstances": true,
        "Client": {
          "$path": "src/client"
        }
      }
    }
  }
}
