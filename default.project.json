        "$className": "Sky",
        "$properties": {
          "StarCount": 5000,
          "SunAngularSize": 0,
          "MoonAngularSize": 0,
          "CelestialBodiesShown": false
        }
      },
      "TerraNovaColor": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Contrast": 0.18,
          "Saturation": 0.32,
          "Brightness": 0.02,
          "TintColor": [
            0.9,
            0.88,
            1.0
