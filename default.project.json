{
  "name": "GalaxyMiningSimulator",
  "serveAddress": "127.0.0.1",
  "servePort": 34872,
  "tree": {
    "$className": "DataModel",
    "$ignoreUnknownInstances": true,
    "Workspace": {
      "$className": "Workspace",
      "$ignoreUnknownInstances": true,
      "TerraNova": { "$path": "src/world/terra-nova.project.json" },
      "SpawnLocation": {
        "$className": "SpawnLocation",
        "$ignoreUnknownInstances": true,
        "$properties": {
          "Anchored": true,
          "Position": [0, 1.5, 0],
          "Size": [8, 1, 8],
          "Neutral": true,
          "Duration": 0,
          "Color": [0.15, 0.85, 0.95],
          "Material": "Metal"
        }
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$ignoreUnknownInstances": true,
      "$properties": {
        "ClockTime": 13.8,
        "Brightness": 2.4,
        "Ambient": [0.37, 0.39, 0.52],
        "OutdoorAmbient": [0.57, 0.62, 0.73],
        "EnvironmentDiffuseScale": 0.45,
        "EnvironmentSpecularScale": 0.5
      },
      "TerraNovaAtmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.29,
          "Haze": 1.7,
          "Glare": 0,
          "Color": [0.65, 0.83, 1.0],
          "Decay": [0.56, 0.48, 0.81]
        }
      }
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$ignoreUnknownInstances": true,
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$ignoreUnknownInstances": true,
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$ignoreUnknownInstances": true,
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$ignoreUnknownInstances": true,
        "Client": {
          "$path": "src/client"
        }
      }
    }
  }
}

